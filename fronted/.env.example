# 摄影分享平台 - 环境变量配置示例

# API 配置
VITE_API_BASE_URL=https://api.photoshare.example.com
VITE_API_TIMEOUT=10000

# 认证配置
VITE_AUTH_TOKEN_KEY=photoshare_auth_token
VITE_REFRESH_TOKEN_KEY=photoshare_refresh_token

# 第三方服务
VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# 功能开关
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# PWA 配置
VITE_PWA_ENABLED=true

# 图片服务
VITE_IMAGE_CDN_URL=https://cdn.photoshare.example.com
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_MAX_HEIGHT=1080

# WebSocket 配置
VITE_WS_URL=wss://ws.photoshare.example.com
